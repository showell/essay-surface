-- fast.shale: the check for every edit, a few seconds. gofmt, vet, the
-- front end's syntax, every Go test on the sample notes, and the comment
-- flow through the real server. It stops at the first stage that fails.
-- Each stage is held to a CPU budget, which a busy box does not break as
-- it does wall time; a budget is several times the stage's usual cost, so
-- only a real slowdown passes it.
--   shale scripts/fast.shale
-- Its last line is "fast: PASS", or a stop that names the stage.

-- In go test -v's output, the failed top-level tests and what they said:
-- each line goes with the test whose "=== RUN" came last before it, so a
-- passing test's logs are left out. A panic is said whole.
function failed_tests(out)
  local logs = {}
  local current = ""
  local names = {}
  local shown = {}
  for l in lines(out) do
    local run_m = re_find(l, "^=== RUN   (\\w+)")
    local fail_m = re_find(l, "^--- FAIL: (\\w+)")
    if run_m ~= nil then
      current = run_m.group
    elseif fail_m ~= nil then
      push(names, fail_m.group)
      for s in get(logs, fail_m.group, {}) do push(shown, s) end
      push(shown, l)
    elseif starts_with(l, "panic:") then
      push(names, current .. " (panic)")
      push(shown, l)
      current = "panic"
    elseif current == "panic" then
      push(shown, l)
    elseif current ~= "" and not starts_with(l, "=== ") and not starts_with(l, "    --- PASS") then
      push_at(logs, current, l)
    end
  end
  return {names = names, lines = shown}
end

-- One stage: its program run, its verdict, its times on one line.
function stage(name, argv, opts)
  opts.timeout_ms = 120000
  opts.whole = 400000
  opts.stage = name
  local r = run(argv, opts)
  if r.code == 0 then return r end
  local failed = failed_tests(r.out)
  if #failed.names == 0 then
    print(join(last(lines(r.out), 60), "\n"))
    fail(name .. ": " .. argv[1] .. " exited " .. r.code)
  end
  print(join(take(failed.lines, 60), "\n"))
  fail(name .. ": " .. #failed.names .. " failed: " .. join(failed.names, ", "))
end

function said(name, r, what)
  print("ok  " .. name .. ", " .. r.ms .. " ms, cpu " .. r.cpu_ms .. " ms" .. what)
end

-- A known-bad go test -v output, read first: a reader that loses a failure
-- or a panic would let a red test stage say too little.
local known = failed_tests(read("testdata/fast/go-test-v.txt"))
if join(known.names, ",") ~= "TestFails,TestPanics (panic)" or find(join(known.lines, "\n"), "what the failing test said") == nil
    or find(join(known.lines, "\n"), "never shown") ~= nil or find(join(known.lines, "\n"), "c_test.go:30") == nil then
  fail("fast's reader of go test misreads testdata/fast/go-test-v.txt: " .. json_write(known))
end

local fmt = stage("gofmt", {"gofmt", "-l", "."}, {cpu_budget_ms = 5000})
if fmt.out ~= "" then
  print(fmt.out)
  fail("gofmt: these files need gofmt -w")
end
said("gofmt", fmt, "")
said("vet", stage("vet", {"go", "vet", "."}, {cpu_budget_ms = 20000}), "")
-- go test embeds comments.js but never parses it.
said("js", stage("js", {"node", "--check", "comments.js"}, {cpu_budget_ms = 5000, want = "check: the front end's syntax, which go test cannot see"}), "")
-- The budget covers compiling the tests after an edit (about 4 s of CPU)
-- and running them (about 3 s).
local test = stage("test", {"go", "test", "-count=1", "-v", "."}, {cpu_budget_ms = 30000})
said("test", test, ": " .. #re_lines(test.out, "^--- PASS") .. " tests passed, " .. #re_lines(test.out, "^    --- PASS") .. " subtests")
local smoke = stage("smoke", {"shale", "scripts/comments_smoke.shale"}, {cpu_budget_ms = 30000})
said("smoke", smoke, ": " .. #re_lines(smoke.out, "^ok: ") .. " checks through the real server")
print("fast: PASS")
