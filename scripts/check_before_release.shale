-- check_before_release.shale: the check before anything ships, on the real notes. Every
-- stage runs, one after another (a timing never runs beside another
-- stage), and the last line says plainly whether it is safe: "SAFE TO
-- SHIP", or "NOT SAFE" and the stages that failed.
--   commit     scripts/check_before_commit.shale: gofmt, vet, the JS, the tests, the smoke
--   race       the tests under the race detector
--   anchoring  the anchoring simulation on the real notes, held to its rates
--   audit      scripts/check_rendered_notes.shale: every real note rendered, nothing left over
--   dates      scripts/check_note_dates.shale: a fresh clone gives the same index,
--              on the sample notes (the real notes are never in git)
--   bench      scripts/measure_server.shale on a copy of the real notes: CPU a request
--              held to budgets a busy box cannot break; wall times judged
--              only when the box is quiet
-- Each stage has a CPU budget, several times its usual cost, so a stage
-- gone slow fails here rather than passing slowly: that stop ends the
-- check at once, naming the stage.
--   shale scripts/check_before_release.shale
--   shale scripts/check_before_release.shale dir=/abs/path/notes
-- The real notes are only read: the bench copies them first, and every
-- server's comments go to a scratch folder under .run.
local dir = arg("dir", "/home/steve/essay-dogfood/notes")

-- One stage run: its verdict and times, and the last s.shown lines of its
-- own output. Gives "PASS" or "FAIL".
function stage(s)
  local run_opts = {timeout_ms = 110000, tail = 400, stage = s.name}
  for k in keys(s.opts) do run_opts[k] = s.opts[k] end
  local r = run(s.argv, run_opts)
  local verdict = "PASS"
  if r.code ~= 0 then verdict = "FAIL" end
  print("== " .. s.name .. ": " .. verdict .. ", " .. r.ms .. " ms, cpu " .. r.cpu_ms .. " ms")
  local own = {}
  for l in lines(r.out) do
    if starts_with(l, "── time:") then break end
    if not starts_with(l, "── ") or starts_with(l, "── stopped") then push(own, l) end
  end
  for l in last(own, s.shown) do print("   " .. l) end
  return verdict
end

local load = essay_load()
print("box: load " .. load.said .. "; notes: " .. dir)
local stages = {
  {name = "commit", argv = {"shale", "scripts/check_before_commit.shale"}, opts = {cpu_budget_ms = 40000}, shown = 6},
  -- The simulation is pure and runs on one goroutine, and is ten times
  -- slower under -race; the anchoring stage runs it on the real notes.
  {name = "race", argv = {"go", "test", "-race", "-count=1", "-skip", "TestSimulateAnchoring", "."}, opts = {cpu_budget_ms = 40000}, shown = 2},
  -- About 15 s of CPU: 187,000 simulated edits, most of it the similarity
  -- search for the blocks that were moved, merged or deleted.
  {name = "anchoring", argv = {"go", "test", "-count=1", "-run", "TestSimulateAnchoring", "-v", "."},
    opts = {cpu_budget_ms = 45000, env = {ESSAY_NOTES = dir}, re = "cases|->|--- |^ok|^FAIL|_test.go"}, shown = 17},
  {name = "audit", argv = {"shale", "scripts/check_rendered_notes.shale", "dir=" .. dir}, opts = {cpu_budget_ms = 20000}, shown = 6},
  {name = "dates", argv = {"shale", "scripts/check_note_dates.shale"}, opts = {cpu_budget_ms = 20000}, shown = 4},
  {name = "bench", argv = {"shale", "scripts/measure_server.shale", "dir=" .. dir, "rounds=500"}, opts = {cpu_budget_ms = 40000}, shown = 6},
}
local failed = {}
for s in stages do
  if stage(s) == "FAIL" then push(failed, s.name) end
end

print("by hand still: an eye test of a note and its comments in a desktop browser")
if #failed > 0 then
  print("NOT SAFE: " .. join(failed, ", ") .. " failed")
  fail("not safe to ship")
end
print("SAFE TO SHIP")
