-- audit.shale: every note rendered through the real server, each page
-- checked for markdown left over outside code (**, ](, |---, a backtick),
-- which is a construct the renderer missed, and for its comment markup: as
-- many data-c blocks as fingerprints in #blocks. One curl fetches every
-- page into .run/audit/pages; the server is stopped before they are read.
-- Its comments folder is .run/audit/comments, so a real one is never read
-- or written.
--   shale scripts/audit.shale                        (the sample notes)
--   shale scripts/audit.shale dir=/abs/path/notes     (any folder)
-- Its last line is "audit: PASS", or a stop that says what was found.
-- Budgets: each page is cut four times and its fingerprints parsed (about
-- 170k steps a page), and the fetch's argv and the index are kept across
-- each yield.
-- budget: steps=200000000 kept_bytes=16000000
local dir = arg("dir", "notes")
const RUN = ".run/audit"

-- Backticks outside code that were looked at and are faithful: each quotes
-- a lone ``` or `\`` in prose, which CommonMark renders as written. A page
-- whose count changes is looked at again.
const FAITHFUL_TICKS = [=[{"essay-surface-monday.md": 3, "essay-surface-quality.md": 3, "update-53-and-the-checklists-first-day.md": 2}]=]

-- s with every open...close stretch cut out, by split and find, which scan
-- the text, where a regex pays its pattern's states at each byte it examines.
function cut(s, open, close)
  local parts = split(s, open)
  local out = {parts[1]}
  for i = 2, #parts do
    local e = find(parts[i], close)
    if e ~= nil then push(out, sub(parts[i], e + #close, #parts[i])) end
  end
  return join(out, " ")
end

function audit(p)
  local page = read(p)
  local blocks = essay_hashes(page)
  local markup = cut(cut(page, "<script", "</script>"), "<style>", "</style>")
  local marked = #find_all(markup, " data-c=\"")
  local body = cut(cut(markup, "<pre", "</pre>"), "<code>", "</code>")
  return {stars = #find_all(body, "**"), links = #find_all(body, "]("), tables = #find_all(body, "|---"), ticks = #find_all(body, "`"),
    blocks = #blocks, mismatch = marked - #blocks}
end

-- A known-bad page and a known-good one, read as every real page is: an
-- audit that passes the bad one is blind, whatever the real pages say.
local known_bad = audit("testdata/audit/bad.html")
if known_bad.stars == 0 or known_bad.links == 0 or known_bad.tables == 0 or known_bad.ticks == 0 or known_bad.mismatch == 0 then
  fail("the audit passes testdata/audit/bad.html: " .. json_write(known_bad))
end
local known_good = audit("testdata/audit/good.html")
if known_good.stars + known_good.links + known_good.tables + known_good.ticks ~= 0 or known_good.mismatch ~= 0 then
  fail("the audit refuses testdata/audit/good.html: " .. json_write(known_good))
end
print("fixtures: bad.html caught, good.html passed")

essay_build()
essay_fresh(RUN .. "/pages")
local job = essay_start(dir, RUN .. "/comments", RUN .. "/server.log")
local index = attempt(http_get, essay_base() .. "/")
local names = {}
local fetched = nil
if index.ok then
  names = essay_names(index.value.body)
  local argv = {"curl", "-s", "--max-time", "60"}
  for n in names do
    push(argv, "-o")
    push(argv, RUN .. "/pages/" .. n .. ".html")
    push(argv, essay_base() .. "/notes/" .. n)
  end
  fetched = run(argv, {timeout_ms = 60000, tail = 5})
end
essay_stop(job, RUN .. "/server.log")
if not index.ok then fail("the index: " .. index.error) end
must(fetched)

local faithful = json_read(FAITHFUL_TICKS)
local leftovers = {}
local mismatched = {}
local unexplained = {}
local blocks = 0
for n in names do
  local a = audit(RUN .. "/pages/" .. n .. ".html")
  a.note = n
  blocks = blocks + a.blocks
  if a.stars + a.links + a.tables + a.ticks > 0 then push(leftovers, a) end
  if a.mismatch ~= 0 then push(mismatched, a) end
  if a.stars + a.links + a.tables > 0 or a.ticks ~= get(faithful, n, 0) then push(unexplained, a) end
  yield()
end
sort(leftovers, "ticks", "desc")
print(#names .. " pages, " .. blocks .. " commentable blocks, " .. #leftovers .. " pages with leftovers")
if #leftovers > 0 then print(table(take(leftovers, 20), {"stars", "links", "tables", "ticks", "note"})) end
if #mismatched > 0 then
  print(table(take(mismatched, 20), {"blocks", "mismatch", "note"}))
  fail(#mismatched .. " pages whose data-c count is not their fingerprint count")
end
if #unexplained > 0 then
  local which = {}
  for a in take(unexplained, 10) do push(which, a.note .. " (" .. a.ticks .. " ticks)") end
  fail(#unexplained .. " pages with leftovers not known to be faithful: " .. join(which, ", "))
end
print("audit: PASS")
