-- bench.shale: the server timed on a copy of a folder of notes, by real
-- HTTP requests on curl's own clock (one curl, one kept-alive connection,
-- so no process start is counted). It times the index, every note, and
-- the largest note; then posts comments (per= on every note, big= on the
-- largest) and times the notes and the largest note again, so a page with
-- comments is measured beside the same page without.
--
-- Its verdict has two parts:
--   cpu      the server's CPU time a request, which it reports when
--            stopped, held to CPU_BUDGET_US. A busy box slows a request's
--            wall time, not the CPU it takes, so this holds on any box.
--   latency  the medians, held to their budgets only when the box was
--            quiet (a load under half its CPUs) before and after; else
--            reported and said to be not judged.
--
-- The notes are copied to .run/bench/notes and the comments go to
-- .run/bench/comments, made fresh each run: the bench reads the folder
-- once and never writes to it.
--   shale scripts/bench.shale                       (the sample notes)
--   shale scripts/bench.shale dir=/abs/path/notes    (any folder)
-- Its last line is "bench: PASS", or a stop that says which budget broke.
-- budget: steps=60000000 reads=20000 kept_bytes=16000000
local dir = arg("dir", "notes")
local rounds = arg("rounds", 200)
local per = arg("per", 3)
local big_n = arg("big", 100)
const BIG = "gopher-roc-demo.md"
const RUN = ".run/bench"
-- The most CPU a request may take in each phase, in microseconds: a
-- little over twice what the real notes took on 2026-11-13 (index 140 and
-- 160, notes 173 and 179, comments 344 and 365). Reading every note's file
-- for each index request, as the server did before, costs about 1,400.
const CPU_BUDGET_US = {index = 400, notes = 400, comments = 800}
-- The medians on a quiet box, in microseconds. The index was 2,276 us
-- while it read every note's file on each request; it is about 105 now.
const MEDIAN_BUDGET_US = [=[{"index": 500, "notes, no comments": 500, "largest note, no comments": 1000, "notes, with comments": 500, "largest note, with comments": 1000}]=]

-- curl's time_total is seconds with six decimals: "0.000412" is 412 us.
function micros(s)
  local parts = split(s, ".")
  local frac = sub(parts[2] .. "000000", 1, 6)
  return parse_int(parts[1]) * 1000000 + parse_int(frac)
end

function pct(sorted, p)
  local i = (#sorted * p + 99) // 100
  if i < 1 then i = 1 end
  return sorted[i]
end

function show_us(us)
  return (us // 1000) .. "." .. sub("" .. (1000 + us % 1000), 2, 4) .. " ms"
end

-- One curl over many URLs; gives {times, bytes, bad} from its -w lines.
function timed(urls)
  local argv = {"curl", "-s", "--max-time", "60"}
  for u in urls do
    push(argv, "-o")
    push(argv, "/dev/null")
    push(argv, "-w")
    push(argv, "%{http_code} %{size_download} %{time_total}\\n")
    push(argv, u)
  end
  local r = must(run(argv, {timeout_ms = 120000, whole = 4000000}))
  local times = {}
  local bytes = 0
  local bad = 0
  for l in lines(r.out) do
    local w = words(l)
    if #w == 3 then
      if w[1] ~= "200" then bad = bad + 1 end
      bytes = bytes + parse_int(w[2])
      push(times, micros(w[3]))
    end
  end
  sort(times)
  return {times = times, bytes = bytes, bad = bad}
end

-- A measured kind of request: its report line, and its median for the verdict.
function report(out, label, t)
  local s = t.times
  push(out.lines, label .. ": " .. #s .. " requests, " .. t.bad .. " not 200, " .. (t.bytes // #s) .. " bytes average; median " ..
    show_us(pct(s, 50)) .. ", p90 " .. show_us(pct(s, 90)) .. ", p99 " .. show_us(pct(s, 99)) .. ", max " .. show_us(s[#s]))
  out.medians[label] = pct(s, 50)
  out.bad = out.bad + t.bad
end

function repeat_url(u, n)
  local out = {}
  for i = 1, n do push(out, u) end
  return out
end

-- One curl posting every comment; gives the count of 201s.
function post_all(posts)
  local argv = {"curl", "-s", "--max-time", "60"}
  local first = true
  for p in posts do
    if not first then push(argv, "--next") end
    first = false
    for a in {"-o", "/dev/null", "-w", "%{http_code}\\n", "-H", "Content-Type: application/json", "--data-binary", p.body, p.url} do push(argv, a) end
  end
  local r = must(run(argv, {timeout_ms = 120000, whole = 200000}))
  return #find_all(r.out, "201")
end

-- Comments on n blocks of a note, spread evenly, from its fetched page.
function comments_for(name, page, n, posts)
  local hs = essay_hashes(read(page))
  if #hs == 0 then return 0 end
  for i = 0, n - 1 do
    local k = i * #hs // n
    push(posts, {url = essay_base() .. "/notes/" .. name .. "/comments",
      body = json_write({block = k, hash = hs[k + 1], name = "Bench", text = "A comment of a sentence or two, about as long as a real one is, number " .. i .. "."})})
  end
  return n
end

function note_urls()
  local out = {}
  for n in essay_names(http_get(essay_base() .. "/").body) do push(out, essay_base() .. "/notes/" .. n) end
  return out
end

-- The phases, each on a server of its own, so the CPU it reports on its
-- way out is that phase's. Their lines are returned, not printed, so the
-- caller can stop the server before anything else.
function phase_index(rounds)
  local out = {lines = {}, medians = {}, bad = 0}
  report(out, "index", timed(repeat_url(essay_base() .. "/", rounds)))
  return out
end

function phase_notes(rounds)
  local out = {lines = {}, medians = {}, bad = 0}
  local notes = note_urls()
  push(out.lines, #notes .. " notes in the index")
  -- A note's page is made on its first request; time the kept pages.
  timed(notes)
  report(out, "notes, no comments", timed(notes))
  report(out, "largest note, no comments", timed(repeat_url(essay_base() .. "/notes/" .. BIG, rounds)))
  return out
end

function phase_comments(rounds, per, big_n)
  local out = {lines = {}, medians = {}, bad = 0}
  local names = essay_names(http_get(essay_base() .. "/").body)
  local notes = {}
  for n in names do push(notes, essay_base() .. "/notes/" .. n) end
  -- Every page once, saved, for its fingerprints.
  local argv = {"curl", "-s", "--max-time", "60"}
  for n in names do
    push(argv, "-o")
    push(argv, RUN .. "/pages/" .. n)
    push(argv, essay_base() .. "/notes/" .. n)
  end
  must(run(argv, {timeout_ms = 120000, tail = 5}))
  local posts = {}
  local wanted = 0
  for n in names do
    local count = per
    if n == BIG then count = big_n end
    wanted = wanted + comments_for(n, RUN .. "/pages/" .. n, count, posts)
    yield()
  end
  local made = post_all(posts)
  push(out.lines, "posted " .. made .. " comments of " .. wanted .. " (" .. per .. " a note, " .. big_n .. " on " .. BIG .. ")")
  if made ~= wanted then fail("only " .. made .. " of " .. wanted .. " comments were taken") end
  -- The first request for each page makes it with its comments; time the
  -- kept pages after.
  timed(notes)
  report(out, "notes, with comments", timed(notes))
  report(out, "largest note, with comments", timed(repeat_url(essay_base() .. "/notes/" .. BIG, rounds)))
  return out
end

-- A phase's end, its server stopped: its lines kept, its medians merged
-- into all, and its CPU a request held to its budget. Gives the CPU line.
function phase_end(name, job, log, result, budget_us, all)
  local cpu = essay_stop(job, log)
  if not result.ok then fail("the bench stopped in " .. name .. ": " .. result.error .. " (line " .. result.line .. ")") end
  for l in result.value.lines do push(all.lines, l) end
  for k in keys(result.value.medians) do all.medians[k] = result.value.medians[k] end
  if result.value.bad > 0 then fail(name .. ": " .. result.value.bad .. " requests were not 200") end
  if cpu == nil then fail(name .. ": the server did not say its CPU time on its way out") end
  local us = cpu.cpu_ms * 1000 // cpu.requests
  local said = "cpu, " .. name .. ": " .. us .. " us a request over " .. cpu.requests .. " requests (" .. cpu.cpu_ms .. " ms), budget " .. budget_us
  if us > budget_us then fail(said) end
  return said .. ": PASS"
end

essay_build()
essay_fresh(RUN)
mkdir(RUN .. "/pages")
must(run({"cp", "-rp", dir, RUN .. "/notes"}, {timeout_ms = 60000, tail = 5}))
local all = {lines = {}, medians = {}}
local verdicts = {}
local before = essay_load()

local job = essay_start(RUN .. "/notes", RUN .. "/comments", RUN .. "/index.log")
local r = attempt(phase_index, rounds)
push(verdicts, phase_end("index", job, RUN .. "/index.log", r, CPU_BUDGET_US.index, all))
for l in lines(read(RUN .. "/index.log")) do
  if find(l, "rendered ") ~= nil or find(l, "cpu: ") ~= nil then print(l) end
end

job = essay_start(RUN .. "/notes", RUN .. "/comments", RUN .. "/notes.log")
r = attempt(phase_notes, rounds)
push(verdicts, phase_end("notes", job, RUN .. "/notes.log", r, CPU_BUDGET_US.notes, all))

job = essay_start(RUN .. "/notes", RUN .. "/comments", RUN .. "/comments.log")
r = attempt(phase_comments, rounds, per, big_n)
push(verdicts, phase_end("comments", job, RUN .. "/comments.log", r, CPU_BUDGET_US.comments, all))

local after = essay_load()
print("servers stopped")
for l in all.lines do print(l) end
for l in verdicts do print(l) end

local quiet = before.hundredths * 2 < before.cpus * 100 and after.hundredths * 2 < after.cpus * 100
if not quiet then
  print("latency: not judged, the box was busy (load " .. before.said .. " before, " .. after.said .. " after)")
else
  local budget = json_read(MEDIAN_BUDGET_US)
  local over = {}
  for label in keys(budget) do
    if all.medians[label] > budget[label] then push(over, label .. " median " .. show_us(all.medians[label]) .. ", budget " .. show_us(budget[label])) end
  end
  if #over > 0 then fail("latency: " .. join(over, "; ")) end
  print("latency: every median within budget (load " .. before.said .. " before, " .. after.said .. " after): PASS")
end
print("bench: PASS")
