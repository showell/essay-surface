-- check_before_commit.shale: the check for every edit, a few seconds. gofmt, vet, the
-- front end's syntax, every Go test on the sample notes, the comment
-- flow through the real server, and the .note path from its Roc to its
-- page (check_note_format.shale), and the self-tests of prune_notes.shale
-- and check_note.shale. It stops at the first stage that fails.
-- Each stage is held to a CPU budget, which a busy box does not break as
-- it does wall time; a budget is several times the stage's usual cost, so
-- only a real slowdown passes it.
--   shale scripts/check_before_commit.shale
-- Its last line is "check before commit: PASS", or a stop that names the stage.

-- In go test -v's output, the failed top-level tests and what they said:
-- each line goes with the test whose "=== RUN" came last before it, so a
-- passing test's logs are left out. A panic is said whole.
function failed_tests(out)
  local logs = {}
  local current = ""
  local names = {}
  local shown = {}
  for l in lines(out) do
    local run_m = re_find(l, "^=== RUN   (\\w+)")
    local fail_m = re_find(l, "^--- FAIL: (\\w+)")
    if run_m ~= nil then
      current = run_m.group
    elseif fail_m ~= nil then
      push(names, fail_m.group)
      for s in get(logs, fail_m.group, {}) do push(shown, s) end
      push(shown, l)
    elseif starts_with(l, "panic:") then
      push(names, current .. " (panic)")
      push(shown, l)
      current = "panic"
    elseif current == "panic" then
      push(shown, l)
    elseif current ~= "" and not starts_with(l, "=== ") and not starts_with(l, "    --- PASS") then
      push_at(logs, current, l)
    end
  end
  return {names = names, lines = shown}
end

-- One stage: its program run, its verdict, its times on one line.
function stage(name, argv, opts)
  local run_opts = {timeout_ms = 120000, whole = 400000, stage = name}
  for key in keys(opts) do run_opts[key] = opts[key] end
  local result = run(argv, run_opts)
  if result.code == 0 then return result end
  local failed = failed_tests(result.out)
  if #failed.names == 0 then
    print(join(last(lines(result.out), 60), "\n"))
    fail(name .. ": " .. argv[1] .. " exited " .. result.code)
  end
  print(join(take(failed.lines, 60), "\n"))
  fail(name .. ": " .. #failed.names .. " failed: " .. join(failed.names, ", "))
end

-- A stage that passed: its name, its times, and what it counted.
function report_pass(name, result, detail)
  print("ok  " .. name .. ", " .. result.ms .. " ms, cpu " .. result.cpu_ms .. " ms" .. detail)
end

-- A known-bad go test -v output, read first: a reader that loses a failure
-- or a panic would let a red test stage say too little.
local known = failed_tests(read("testdata/fast/go-test-v.txt"))
local known_said = join(known.lines, "\n")
local names_both = join(known.names, ",") == "TestFails,TestPanics (panic)"
local keeps_failing_log = find(known_said, "what the failing test said") ~= nil
local drops_passing_log = find(known_said, "never shown") == nil
local keeps_panic_trace = find(known_said, "c_test.go:30") ~= nil
if not (names_both and keeps_failing_log and drops_passing_log and keeps_panic_trace) then
  fail("the commit check's reader of go test misreads testdata/fast/go-test-v.txt: " .. json_write(known))
end

local gofmt_result = stage("gofmt", {"gofmt", "-l", "."}, {cpu_budget_ms = 5000})
if gofmt_result.out ~= "" then
  print(gofmt_result.out)
  fail("gofmt: these files need gofmt -w")
end
report_pass("gofmt", gofmt_result, "")
report_pass("vet", stage("vet", {"go", "vet", "."}, {cpu_budget_ms = 20000}), "")
-- go test embeds comments.js and tables.js but never parses them.
report_pass("js comments.js", stage("js comments.js", {"node", "--check", "comments.js"}, {cpu_budget_ms = 5000, want = "check: the front end's syntax, which go test cannot see"}), "")
report_pass("js tables.js", stage("js tables.js", {"node", "--check", "tables.js"}, {cpu_budget_ms = 5000, want = "check: the front end's syntax, which go test cannot see"}), "")
-- The sortable tables' kinds and orders, in node: tables_test.cjs.
local tables_result = stage("tables", {"node", "tables_test.cjs"}, {cpu_budget_ms = 5000, want = "test: the sortable tables' pure half, which go test cannot run"})
report_pass("tables", tables_result, ": " .. #re_lines(tables_result.out, "^ok: ") .. " checks")
-- The budget covers compiling the tests after an edit (about 4 s of CPU)
-- and running them (about 3 s).
local test_result = stage("test", {"go", "test", "-count=1", "-v", "."}, {cpu_budget_ms = 30000})
report_pass("test", test_result, ": " .. #re_lines(test_result.out, "^--- PASS") .. " tests passed, " .. #re_lines(test_result.out, "^    --- PASS") .. " subtests")
local smoke_result = stage("smoke", {"shale", "scripts/check_comment_flow.shale"}, {cpu_budget_ms = 30000})
report_pass("smoke", smoke_result, ": " .. #re_lines(smoke_result.out, "^ok: ") .. " checks through the real server")
local note_result = stage("note", {"shale", "scripts/check_note_format.shale"}, {cpu_budget_ms = 30000})
report_pass("note", note_result, ": " .. #re_lines(note_result.out, "^ok: ") .. " checks, from the Roc to the page")
report_pass("prune", stage("prune", {"shale", "scripts/prune_notes.shale", "self_test=1"}, {cpu_budget_ms = 10000}), "")
local diagrams_result = stage("diagrams", {"shale", "scripts/check_note.shale", "self_test=1"}, {cpu_budget_ms = 15000})
report_pass("diagrams", diagrams_result, ": " .. #re_lines(diagrams_result.out, "^ok: ") .. " planted cases")
print("check before commit: PASS")
